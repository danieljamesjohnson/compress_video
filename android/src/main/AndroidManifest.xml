<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.danjjohnson.compress_video">

  <!-- JOBS-05 (D-08): opt-in per job via CompressOptions.androidForegroundService. Both
       permissions are inert unless a caller sets that option; no notification permission is
       requested here, since whether to ask the user for one is the host app's own decision. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

  <application>
    <!-- Started only by this plugin's own in-process code (ForegroundServiceHost.attach),
         never exported, with no intent filter (T-05-11). -->
    <service
      android:name=".ForegroundServiceHost"
      android:exported="false"
      android:foregroundServiceType="mediaProcessing" />
  </application>
</manifest>
