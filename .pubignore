# A .pubignore in a directory completely replaces that directory's .gitignore for
# `dart pub publish` purposes, so the standard build-artifact entries are repeated here
# alongside the publish-only exclusions. See corpus/README.md and 01-CONTEXT.md.

# Build artifacts (repeated from .gitignore — see note above)
.dart_tool/
build/
.packages
pubspec.lock
*.iml
.idea/
.DS_Store
.venv*/

# GSD run-scoped sentinels (repeated from .gitignore)
.gsd/

# Flutter plugin build artifacts (repeated from .gitignore)
example/ios/Pods/
example/macos/Pods/
example/ios/.symlinks/
example/macos/.symlinks/
**/Flutter/ephemeral/
.flutter-plugins
.flutter-plugins-dependencies

# dartdoc output (repeated from .gitignore)
doc/api/

# Publish-only exclusions
corpus/
.planning/
.mission-control/
.claude/
.github/
example/integration_test/_scratch/
QUESTIONS.md

# NOTE: example/assets/corpus/ is deliberately NOT excluded — the example app needs its
# bundled clips to run, and the example app itself is part of what pub.dev shows.
